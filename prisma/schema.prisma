generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Enrollment {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  dateOfBirth String
  gender      String
  careerTrack String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
